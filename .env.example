# Secretos de Bingo Sorpresa, leídos por docker-compose.yml (dev) y docker-compose.prod.yml.
# Copia a .env (no versionado) y rellena. Prod necesita valores PROPIOS y fuertes: JWT_SECRET firma
# también las URLs de las imágenes (img.php).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Solo prod (docker-compose.prod.yml). Mínimo 32 caracteres (p. ej. `openssl rand -hex 32`).
JWT_SECRET=
# Solo dev (docker-compose.yml, que lo pasa al contenedor como JWT_SECRET). DISTINTO del de prod:
# si coinciden, un token hecho a mano en dev vale en prod.
DEV_JWT_SECRET=
# Cliente OAuth web propio de Bingo Sorpresa (no se comparte con otros proyectos). Vacío en dev.
GOOGLE_CLIENT_ID=
# Lista separada por comas para cerrar el registro (plan B ante abuso). Vacío = abierto.
ALLOWED_EMAILS=
